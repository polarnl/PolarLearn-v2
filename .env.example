# Database (Required)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/polarlearn

# App Related
APP_BASE=http://localhost:5173
APP_LANG=nl
SECRET=change-me-to-a-long-random-string

# Email / SMTP (optional)
SMTP_HOST=your.smtp.host
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

SMTP_FROM=

# Object storage (optional, required for profile-picture uploads)
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_USE_PATH_STYLE=false

LOG_LEVEL=info

LOKI_HOST=
LOKI_BASIC_AUTH= # "username:password"
