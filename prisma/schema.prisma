model List {
  id            String         @id
  name          String
  description   String?
  subject       String
  userId        String
  user          User           @relation("ListOwnership", fields: [userId], references: [id], onDelete: Cascade)
  items         Json
  versionData   Json           @default("{}")
  collaborators User[]         @relation("ListCollaborators")
  favoritedBy   User[]         @relation("FavoriteLists")
  verified      Boolean        @default(false)
  sessions      LearnSession[]
  inGroups      Group[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([subject])
}

// NOTE: This schema has to be **IDENTICAL** to the Zustand store for seamless resuning of sessions.
// edit: fuck that (partially)
model LearnSession {
  id         String  @id
  listId     String
  list       List    @relation(fields: [listId], references: [id], onDelete: Cascade)
  userId     String
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  queue      Json[]
  answerLog  Json[]
  commit     String?
  mode       String?
  isComplete Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([listId])
  @@index([userId, isComplete])
  @@index([userId, listId])
}

model Quiz {
  id            String   @id
  title         String
  description   String?
  subject       String
  userId        String
  user          User     @relation("QuizOwnership", fields: [userId], references: [id], onDelete: Cascade)
  questions     Json
  versionData   Json     @default("{}")
  collaborators User[]   @relation("QuizCollaborators")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ForumPost {
  id               String      @id
  title            String? // not obligated for replies
  content          String
  category         String
  subject          String? // only if category == "school-related"
  votes            Int         @default(0)
  pinned           Boolean     @default(false)
  authorId         String
  author           User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  cachedTotalVotes Int         @default(0)
  voters           Json
  deleted          Boolean     @default(false)
  isReply          Boolean     @default(false)
  replyToId        String?
  replyTo          ForumPost?  @relation("ReplyRelation", fields: [replyToId], references: [id], onDelete: Cascade)
  replies          ForumPost[] @relation("ReplyRelation")

  // PR discussions are saved as forum post to reuse stuff
  associatedQuiz   String?
  associatedList   String?
  associatedBranch String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId])
  @@index([deleted])
  @@index([isReply, deleted, createdAt])
  @@index([replyToId, deleted, pinned, createdAt, id])
  @@index([category, createdAt])
}

model Group {
  id                  String  @id
  name                String
  description         String?
  image               String?
  members             User[]  @relation("UserGroups")
  lists               List[]
  creatorId           String
  creator             User    @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  approvalRequired    Boolean @default(false)
  approvalQueue       User[]  @relation("UserGroupApplications")
  moderators          User[]  @relation("UserGroupModerators")
  onlyModsCanAddLists Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  icon      String
  navigate  String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Config {
  id    String @id
  scope String // global for entire platform, or tenant-specific (uuid)
  key   String
  value String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}